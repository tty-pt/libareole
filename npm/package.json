  "scripts": {
    "build:wasm": "make -C .. wasm",
    "build": "npm run build:wasm",
    "test": "node --test tests/areole.test.mjs"
  },
  "peerDependencies": {
    "@tty-pt/stele": ">=1.7.0"
  },
  "devDependencies": {
    "@tty-pt/stele": "^1.7.0"
  },
  "keywords": [
    "areole",
    "spatial",
    "quadtree",
    "clipmap",
    "lod",
    "terrain",
