  "type": "module",
  "description": "Universal Node.js and Browser WebAssembly bindings for libareole generic distance-adaptive multi-scale spatial quadtree and LOD hierarchy",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "include",
    "*.pc",
